{
  "name": "@mini-profile/mediabunny-custom-format",
  "description": "The bridge for custom format for Mediabunny used in Mini Profile monorepo",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^20",
    "eslint": "^10",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.5",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "mediabunny": "^1.55.2",
    "typescript": "^5"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier -w '**/*.ts'",
    "typecheck": "tsc --noEmit",
    "build": "tsdown --publint",
    "prepack": "bun scripts/prepack && bun run build",
    "postpack": "bun scripts/postpack"
  }
}